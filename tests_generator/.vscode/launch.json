{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch",
      "cargo": {
        "args": ["build", "--lib", "--target=x86_64-pc-windows-msvc"]
      },
      "args": []
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'tests_generator'",
      "cargo": {
        "args": [
          "build",
          "--bin=tests_generator",
          "--package=tests_generator",
          "--target=x86_64-pc-windows-msvc"
        ],
        "filter": {
          "name": "tests_generator",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'tests_generator'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bin=tests_generator",
          "--package=tests_generator"
        ],
        "filter": {
          "name": "tests_generator",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}

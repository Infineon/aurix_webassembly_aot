;; my own tests for i32 instructions

(module
  ;; Function definitions for signed less-than (lt_s)
  (func (export "x_lt_s_0") (param $x i32) (result i32) (i32.lt_s (local.get $x) (i32.const 0)))
  (func (export "x_lt_s_1") (param $x i32) (result i32) (i32.lt_s (local.get $x) (i32.const 1)))
  (func (export "x_lt_s_-1") (param $x i32) (result i32) (i32.lt_s (local.get $x) (i32.const -1)))
  (func (export "x_lt_s_0x80000000") (param $x i32) (result i32) (i32.lt_s (local.get $x) (i32.const 0x80000000)))
  (func (export "x_lt_s_0x7fffffff") (param $x i32) (result i32) (i32.lt_s (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_lt_s_x") (param $x i32) (result i32) (i32.lt_s (i32.const 0) (local.get $x)))
  (func (export "1_lt_s_x") (param $x i32) (result i32) (i32.lt_s (i32.const 1) (local.get $x)))
  (func (export "-1_lt_s_x") (param $x i32) (result i32) (i32.lt_s (i32.const -1) (local.get $x)))
  (func (export "0x80000000_lt_s_x") (param $x i32) (result i32) (i32.lt_s (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_lt_s_x") (param $x i32) (result i32) (i32.lt_s (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for unsigned less-than (lt_u)
  (func (export "x_lt_u_0") (param $x i32) (result i32) (i32.lt_u (local.get $x) (i32.const 0)))
  (func (export "x_lt_u_1") (param $x i32) (result i32) (i32.lt_u (local.get $x) (i32.const 1)))
  (func (export "x_lt_u_-1") (param $x i32) (result i32) (i32.lt_u (local.get $x) (i32.const -1)))
  (func (export "x_lt_u_0x80000000") (param $x i32) (result i32) (i32.lt_u (local.get $x) (i32.const 0x80000000)))
  (func (export "x_lt_u_0x7fffffff") (param $x i32) (result i32) (i32.lt_u (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_lt_u_x") (param $x i32) (result i32) (i32.lt_u (i32.const 0) (local.get $x)))
  (func (export "1_lt_u_x") (param $x i32) (result i32) (i32.lt_u (i32.const 1) (local.get $x)))
  (func (export "-1_lt_u_x") (param $x i32) (result i32) (i32.lt_u (i32.const -1) (local.get $x)))
  (func (export "0x80000000_lt_u_x") (param $x i32) (result i32) (i32.lt_u (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_lt_u_x") (param $x i32) (result i32) (i32.lt_u (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for signed less-than or equal (le_s)
  (func (export "x_le_s_0") (param $x i32) (result i32) (i32.le_s (local.get $x) (i32.const 0)))
  (func (export "x_le_s_1") (param $x i32) (result i32) (i32.le_s (local.get $x) (i32.const 1)))
  (func (export "x_le_s_-1") (param $x i32) (result i32) (i32.le_s (local.get $x) (i32.const -1)))
  (func (export "x_le_s_0x80000000") (param $x i32) (result i32) (i32.le_s (local.get $x) (i32.const 0x80000000)))
  (func (export "x_le_s_0x7fffffff") (param $x i32) (result i32) (i32.le_s (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_le_s_x") (param $x i32) (result i32) (i32.le_s (i32.const 0) (local.get $x)))
  (func (export "1_le_s_x") (param $x i32) (result i32) (i32.le_s (i32.const 1) (local.get $x)))
  (func (export "-1_le_s_x") (param $x i32) (result i32) (i32.le_s (i32.const -1) (local.get $x)))
  (func (export "0x80000000_le_s_x") (param $x i32) (result i32) (i32.le_s (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_le_s_x") (param $x i32) (result i32) (i32.le_s (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for unsigned less-than or equal (le_u)
  (func (export "x_le_u_0") (param $x i32) (result i32) (i32.le_u (local.get $x) (i32.const 0)))
  (func (export "x_le_u_1") (param $x i32) (result i32) (i32.le_u (local.get $x) (i32.const 1)))
  (func (export "x_le_u_-1") (param $x i32) (result i32) (i32.le_u (local.get $x) (i32.const -1)))
  (func (export "x_le_u_0x80000000") (param $x i32) (result i32) (i32.le_u (local.get $x) (i32.const 0x80000000)))
  (func (export "x_le_u_0x7fffffff") (param $x i32) (result i32) (i32.le_u (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_le_u_x") (param $x i32) (result i32) (i32.le_u (i32.const 0) (local.get $x)))
  (func (export "1_le_u_x") (param $x i32) (result i32) (i32.le_u (i32.const 1) (local.get $x)))
  (func (export "-1_le_u_x") (param $x i32) (result i32) (i32.le_u (i32.const -1) (local.get $x)))
  (func (export "0x80000000_le_u_x") (param $x i32) (result i32) (i32.le_u (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_le_u_x") (param $x i32) (result i32) (i32.le_u (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for signed greater-than (gt_s)
  (func (export "x_gt_s_0") (param $x i32) (result i32) (i32.gt_s (local.get $x) (i32.const 0)))
  (func (export "x_gt_s_1") (param $x i32) (result i32) (i32.gt_s (local.get $x) (i32.const 1)))
  (func (export "x_gt_s_-1") (param $x i32) (result i32) (i32.gt_s (local.get $x) (i32.const -1)))
  (func (export "x_gt_s_0x80000000") (param $x i32) (result i32) (i32.gt_s (local.get $x) (i32.const 0x80000000)))
  (func (export "x_gt_s_0x7fffffff") (param $x i32) (result i32) (i32.gt_s (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_gt_s_x") (param $x i32) (result i32) (i32.gt_s (i32.const 0) (local.get $x)))
  (func (export "1_gt_s_x") (param $x i32) (result i32) (i32.gt_s (i32.const 1) (local.get $x)))
  (func (export "-1_gt_s_x") (param $x i32) (result i32) (i32.gt_s (i32.const -1) (local.get $x)))
  (func (export "0x80000000_gt_s_x") (param $x i32) (result i32) (i32.gt_s (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_gt_s_x") (param $x i32) (result i32) (i32.gt_s (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for unsigned greater-than (gt_u)
  (func (export "x_gt_u_0") (param $x i32) (result i32) (i32.gt_u (local.get $x) (i32.const 0)))
  (func (export "x_gt_u_1") (param $x i32) (result i32) (i32.gt_u (local.get $x) (i32.const 1)))
  (func (export "x_gt_u_-1") (param $x i32) (result i32) (i32.gt_u (local.get $x) (i32.const -1)))
  (func (export "x_gt_u_0x80000000") (param $x i32) (result i32) (i32.gt_u (local.get $x) (i32.const 0x80000000)))
  (func (export "x_gt_u_0x7fffffff") (param $x i32) (result i32) (i32.gt_u (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_gt_u_x") (param $x i32) (result i32) (i32.gt_u (i32.const 0) (local.get $x)))
  (func (export "1_gt_u_x") (param $x i32) (result i32) (i32.gt_u (i32.const 1) (local.get $x)))
  (func (export "-1_gt_u_x") (param $x i32) (result i32) (i32.gt_u (i32.const -1) (local.get $x)))
  (func (export "0x80000000_gt_u_x") (param $x i32) (result i32) (i32.gt_u (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_gt_u_x") (param $x i32) (result i32) (i32.gt_u (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for signed greater-than or equal (ge_s)
  (func (export "x_ge_s_0") (param $x i32) (result i32) (i32.ge_s (local.get $x) (i32.const 0)))
  (func (export "x_ge_s_1") (param $x i32) (result i32) (i32.ge_s (local.get $x) (i32.const 1)))
  (func (export "x_ge_s_-1") (param $x i32) (result i32) (i32.ge_s (local.get $x) (i32.const -1)))
  (func (export "x_ge_s_0x80000000") (param $x i32) (result i32) (i32.ge_s (local.get $x) (i32.const 0x80000000)))
  (func (export "x_ge_s_0x7fffffff") (param $x i32) (result i32) (i32.ge_s (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_ge_s_x") (param $x i32) (result i32) (i32.ge_s (i32.const 0) (local.get $x)))
  (func (export "1_ge_s_x") (param $x i32) (result i32) (i32.ge_s (i32.const 1) (local.get $x)))
  (func (export "-1_ge_s_x") (param $x i32) (result i32) (i32.ge_s (i32.const -1) (local.get $x)))
  (func (export "0x80000000_ge_s_x") (param $x i32) (result i32) (i32.ge_s (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_ge_s_x") (param $x i32) (result i32) (i32.ge_s (i32.const 0x7fffffff) (local.get $x)))

  ;; Function definitions for unsigned greater-than or equal (ge_u)
  (func (export "x_ge_u_0") (param $x i32) (result i32) (i32.ge_u (local.get $x) (i32.const 0)))
  (func (export "x_ge_u_1") (param $x i32) (result i32) (i32.ge_u (local.get $x) (i32.const 1)))
  (func (export "x_ge_u_-1") (param $x i32) (result i32) (i32.ge_u (local.get $x) (i32.const -1)))
  (func (export "x_ge_u_0x80000000") (param $x i32) (result i32) (i32.ge_u (local.get $x) (i32.const 0x80000000)))
  (func (export "x_ge_u_0x7fffffff") (param $x i32) (result i32) (i32.ge_u (local.get $x) (i32.const 0x7fffffff)))

  (func (export "0_ge_u_x") (param $x i32) (result i32) (i32.ge_u (i32.const 0) (local.get $x)))
  (func (export "1_ge_u_x") (param $x i32) (result i32) (i32.ge_u (i32.const 1) (local.get $x)))
  (func (export "-1_ge_u_x") (param $x i32) (result i32) (i32.ge_u (i32.const -1) (local.get $x)))
  (func (export "0x80000000_ge_u_x") (param $x i32) (result i32) (i32.ge_u (i32.const 0x80000000) (local.get $x)))
  (func (export "0x7fffffff_ge_u_x") (param $x i32) (result i32) (i32.ge_u (i32.const 0x7fffffff) (local.get $x)))
)



;; lt_s tests
(assert_return (invoke "x_lt_s_0" (i32.const 0)) (i32.const 0))
(assert_return (invoke "x_lt_s_1" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_lt_s_1" (i32.const -1)) (i32.const 1))
(assert_return (invoke "x_lt_s_0x80000000" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_lt_s_0x7fffffff" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "x_lt_s_-1" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_lt_s_0" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_lt_s_1" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_lt_s_0" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_lt_s_0x80000000" (i32.const 0)) (i32.const 0))
(assert_return (invoke "x_lt_s_-1" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_lt_s_0x80000000" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_lt_s_0x7fffffff" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_lt_s_0x80000000" (i32.const 0x7fffffff)) (i32.const 0))

(assert_return (invoke "0_lt_s_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "1_lt_s_x" (i32.const 1)) (i32.const 0))
(assert_return (invoke "-1_lt_s_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_lt_s_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x7fffffff_lt_s_x" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "-1_lt_s_x" (i32.const -1)) (i32.const 0))
(assert_return (invoke "1_lt_s_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_lt_s_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_lt_s_x" (i32.const 0)) (i32.const 1))
(assert_return (invoke "0_lt_s_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_lt_s_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "-1_lt_s_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_lt_s_x" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "0x7fffffff_lt_s_x" (i32.const 0x80000000)) (i32.const 0))

;; lt_u tests
(assert_return (invoke "x_lt_u_0" (i32.const 0)) (i32.const 0))
(assert_return (invoke "x_lt_u_1" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_lt_u_1" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_lt_u_0x80000000" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_lt_u_0x7fffffff" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "x_lt_u_-1" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_lt_u_0" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_lt_u_1" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_lt_u_0" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_lt_u_0x80000000" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_lt_u_-1" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_lt_u_0x80000000" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_lt_u_0x7fffffff" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_lt_u_0x80000000" (i32.const 0x7fffffff)) (i32.const 1))

(assert_return (invoke "0_lt_u_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "1_lt_u_x" (i32.const 1)) (i32.const 0))
(assert_return (invoke "-1_lt_u_x" (i32.const 1)) (i32.const 0))
(assert_return (invoke "0x80000000_lt_u_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x7fffffff_lt_u_x" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "-1_lt_u_x" (i32.const -1)) (i32.const 0))
(assert_return (invoke "1_lt_u_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_lt_u_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_lt_u_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_lt_u_x" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "0x80000000_lt_u_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "-1_lt_u_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_lt_u_x" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "0x7fffffff_lt_u_x" (i32.const 0x80000000)) (i32.const 1))

;; le_s tests
(assert_return (invoke "x_le_s_0" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_le_s_1" (i32.const 1)) (i32.const 1))
(assert_return (invoke "x_le_s_1" (i32.const -1)) (i32.const 1))
(assert_return (invoke "x_le_s_0x80000000" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_s_0x7fffffff" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "x_le_s_-1" (i32.const -1)) (i32.const 1))
(assert_return (invoke "x_le_s_0" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_le_s_1" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_le_s_0" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_s_0x80000000" (i32.const 0)) (i32.const 0))
(assert_return (invoke "x_le_s_-1" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_s_0x80000000" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_le_s_0x7fffffff" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_s_0x80000000" (i32.const 0x7fffffff)) (i32.const 0))

(assert_return (invoke "0_le_s_x" (i32.const 0)) (i32.const 1))
(assert_return (invoke "1_le_s_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "-1_le_s_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_le_s_x" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "0x7fffffff_le_s_x" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "-1_le_s_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "1_le_s_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_le_s_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_le_s_x" (i32.const 0)) (i32.const 1))
(assert_return (invoke "0_le_s_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_le_s_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "-1_le_s_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_le_s_x" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "0x7fffffff_le_s_x" (i32.const 0x80000000)) (i32.const 0))

;; le_u tests
(assert_return (invoke "x_le_u_0" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_le_u_1" (i32.const 1)) (i32.const 1))
(assert_return (invoke "x_le_u_1" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_le_u_0x80000000" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_u_0x7fffffff" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "x_le_u_-1" (i32.const -1)) (i32.const 1))
(assert_return (invoke "x_le_u_0" (i32.const 1)) (i32.const 0))
(assert_return (invoke "x_le_u_1" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_le_u_0" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_le_u_0x80000000" (i32.const 0)) (i32.const 1))
(assert_return (invoke "x_le_u_-1" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "x_le_u_0x80000000" (i32.const -1)) (i32.const 0))
(assert_return (invoke "x_le_u_0x7fffffff" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "x_le_u_0x80000000" (i32.const 0x7fffffff)) (i32.const 1))

(assert_return (invoke "0_le_u_x" (i32.const 0)) (i32.const 1))
(assert_return (invoke "1_le_u_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "-1_le_u_x" (i32.const 1)) (i32.const 0))
(assert_return (invoke "0x80000000_le_u_x" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "0x7fffffff_le_u_x" (i32.const 0x7fffffff)) (i32.const 1))
(assert_return (invoke "-1_le_u_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "1_le_u_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_le_u_x" (i32.const 1)) (i32.const 1))
(assert_return (invoke "0x80000000_le_u_x" (i32.const 0)) (i32.const 0))
(assert_return (invoke "0_le_u_x" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "0x80000000_le_u_x" (i32.const -1)) (i32.const 1))
(assert_return (invoke "-1_le_u_x" (i32.const 0x80000000)) (i32.const 0))
(assert_return (invoke "0x80000000_le_u_x" (i32.const 0x7fffffff)) (i32.const 0))
(assert_return (invoke "0x7fffffff_le_u_x" (i32.const 0x80000000)) (i32.const 1))

;; gt_s tests

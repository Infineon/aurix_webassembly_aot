;; Spill stress tests with architecture-neutral shape.
;; Each function uses exactly 40 parameters and one very long right-deep add chain.
;; A small call is done before and after the long chain to force context interaction.

(module
  (func $dummy)
  (func $dummy_i32 (param i32))
  (func $dummy_i64 (param i64))
  (func $dummy_f32 (param f32))
  (func $dummy_f64 (param f64))

  (func (export "i32_right_deep_40")
    (param $a0 i32) (param $a1 i32) (param $a2 i32) (param $a3 i32) (param $a4 i32)
    (param $a5 i32) (param $a6 i32) (param $a7 i32) (param $a8 i32) (param $a9 i32)
    (param $a10 i32) (param $a11 i32) (param $a12 i32) (param $a13 i32) (param $a14 i32)
    (param $a15 i32) (param $a16 i32) (param $a17 i32) (param $a18 i32) (param $a19 i32)
    (param $a20 i32) (param $a21 i32) (param $a22 i32) (param $a23 i32) (param $a24 i32)
    (param $a25 i32) (param $a26 i32) (param $a27 i32) (param $a28 i32) (param $a29 i32)
    (param $a30 i32) (param $a31 i32) (param $a32 i32) (param $a33 i32) (param $a34 i32)
    (param $a35 i32) (param $a36 i32) (param $a37 i32) (param $a38 i32) (param $a39 i32)
    (result i32)
    (local $tmp i32)

    (call $dummy)
    (block
      (local.get $a0)
      (local.get $a1)
      (i32.add)
      (call $dummy_i32)
    )

    (local.set $tmp
      (i32.add (local.get $a0)
        (i32.add (local.get $a1)
          (i32.add (local.get $a2)
            (i32.add (local.get $a3)
              (i32.add (local.get $a4)
                (i32.add (local.get $a5)
                  (i32.add (local.get $a6)
                    (i32.add (local.get $a7)
                      (i32.add (local.get $a8)
                        (i32.add (local.get $a9)
                          (i32.add (local.get $a10)
                            (i32.add (local.get $a11)
                              (i32.add (local.get $a12)
                                (i32.add (local.get $a13)
                                  (i32.add (local.get $a14)
                                    (i32.add (local.get $a15)
                                      (i32.add (local.get $a16)
                                        (i32.add (local.get $a17)
                                          (i32.add (local.get $a18)
                                            (i32.add (local.get $a19)
                                              (i32.add (local.get $a20)
                                                (i32.add (local.get $a21)
                                                  (i32.add (local.get $a22)
                                                    (i32.add (local.get $a23)
                                                      (i32.add (local.get $a24)
                                                        (i32.add (local.get $a25)
                                                          (i32.add (local.get $a26)
                                                            (i32.add (local.get $a27)
                                                              (i32.add (local.get $a28)
                                                                (i32.add (local.get $a29)
                                                                  (i32.add (local.get $a30)
                                                                    (i32.add (local.get $a31)
                                                                      (i32.add (local.get $a32)
                                                                        (i32.add (local.get $a33)
                                                                          (i32.add (local.get $a34)
                                                                            (i32.add (local.get $a35)
                                                                              (i32.add (local.get $a36)
                                                                                (i32.add (local.get $a37)
                                                                                  (i32.add (local.get $a38)
                                                                                    (local.get $a39))))))))))))))))))))))))))))))))))))))))
    )

    (call $dummy)
    (i32.add (local.get $tmp) (i32.const 1))
  )

